# .gitignore para proyectos React (Create React App, Vite, Next.js)

# Dependencias
node_modules/

# Archivos de entorno (contienen secretos)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Directorios de salida / build
build/
dist/
.out/
.next/
.astro/
.public/

# Cache / Temp
.cache/
.parcel-cache/
.vite/
.turbo/

# Coverage
coverage/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Runtime data
pids/
*.pid
*.seed

# Editor/IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Sistema operativo
.DS_Store
Thumbs.db

# REPL history
.node_repl_history

# Build artifacts
*.local

# Yarn v2+ cache
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Optional: lockfile (comentar si se desea rastrear)
# package-lock.json
# yarn.lock

# Vercel / Netlify / Deploy
.vercel/
.netlify/
.now/

# Misc
*.tgz

# Fin

