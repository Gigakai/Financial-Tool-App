# .gitignore para un proyecto Node.js

# Dependencias
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Directorios de salida / build
dist/
build/
out/
coverage/

# Archivos de entorno (contienen secretos)
.env
.env.*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Cachés
.npm/
.cache/
.tmp/

# Directorios de dependencias alternativos
jspm_packages/
bower_components/

# Editor/IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Sistema operativo
.DS_Store
Thumbs.db

# REPL history
.node_repl_history

# Eslint cache
.eslintcache

# Yarn v2+ cache (si se usa Yarn Plug'n'Play)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Optional: lockfile (opcional, comentar si no desea ignorar)
# package-lock.json
# yarn.lock

# Coverage reports

# Misc
*.local

# End of file
