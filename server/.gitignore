# Gitignore para Node.js + TypeScript (servidor MCP)
# Generado/actualizado por asistente - incluye reglas comunes para Node, TypeScript y herramientas relacionadas.

# Node
node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov/

# Coverage directory used by tools like istanbul
coverage/
.nyc_output/

# Build output
dist/
build/
out/
lib/

# TypeScript
*.tsbuildinfo
# If you build into a specific folder (dist, build, out) those are already ignored above.

# Optional npm cache directory
.npm/

# Environment variables
.env
.env.*.local

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS files
.DS_Store
Thumbs.db

# Debug
.vscode-test/

# Temporary files
tmp/
temp/

# Yarn v2/berry
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# pnpm
.pnpm-debug.log
.pnpm-store/

# Parcel cache
.cache/

# Compiled source (if you accidentally compile into source folders)
# Prefer ignoring compiled code in build/dist; avoid ignoring .d.ts in types/ if they're handwritten.
*.js
*.js.map

# TypeScript declaration output (if generated during build)
*.d.ts.map

# Misc
*.pem
*.key
*.crt
*.env.local
*.secret

# Service/tool specific
.serverless/
.vercel/

# Lockfiles: generalmente se deben versionar (package-lock.json / pnpm-lock.yaml / yarn.lock)
# Si quieres ignorar alguno, descomenta la línea correspondiente:
# package-lock.json
# pnpm-lock.yaml
# yarn.lock

# MCP-related: si el flujo de MCP genera artefactos o carpetas específicas, añádelas aquí.
# Por ejemplo:
# mcp-build/
# mcp-artifacts/
